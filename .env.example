# Live backend — OpenAI-compatible endpoints
LIVE_API_URL=https://your-api-url/v1
LIVE_API_KEY=your-api-key
LIVE_MODEL=gemma4:31b

# Lite — small-context tasks (chat titles, memory extraction)
LITE_API_URL=https://your-lite-api-url/v1
LITE_API_KEY=your-lite-api-key
LITE_MODEL=llama3.1-8B

# Image — GPT Images API compatible
IMAGE_API_URL=https://your-image-api-url/v1
IMAGE_API_KEY=your-image-api-key
IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_MODEL_FAST=gpt-image-2.5-flare

# Usage limits, per-identity plan tiers (Free / Supporters / Cools / Owner),
# each with a 5h AND 7d token budget, enforced on chat, titles, and
# memory extraction; failures to read the store fail open
# Ledger is auto off on serverless (Vercel, one shared identity,
# storage resets per cold start); it runs on a VPS or LAN self-host,
# no flag needed
# DEEPCHAT_USAGE_ADMIN enables POST /api/usage for plan changes per
# client IP, default off; never set it on a public deploy, any visitor
# could tier the shared identity
#DEEPCHAT_USAGE_ADMIN=1
