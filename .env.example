# AI Relay (api_deepchat) — server-side only (never use NEXT_PUBLIC_ or VITE_ prefixes)
# Dev example: http://localhost:3000 | Prod example: https://api.deepsia.my.id
AI_RELAY_BASE_URL=https://api.deepsia.my.id
AI_RELAY_CLIENT_SECRET=your-ai-relay-client-secret

# Optional model overrides (defaults are configured in src/lib/ai/models.ts)
# one entry per row: MODEL_ID|Display Name|description|maxEffort (name/description/maxEffort optional, id exact)
# maxEffort: light | medium | high | extra-high | ultra (default: ultra)
LIVE_MODEL=gemma4:31b,claude-sonnet-4-6|Claude Sonnet|good at long context|high,llama-3.1-8b|Llama 3.1|small and fast|medium
LITE_MODEL=qwen3.8-27b,deepseek-v3.2|DeepSeek V3|reasoning lite|high

# Optional per-model or global effort cap (light | medium | high | extra-high | ultra)
# Example: MODEL_MAX_EFFORT=deepseek-v4.1|high,llama-3.1-8b|medium,*|extra-high
#MODEL_MAX_EFFORT=

# Image generation models routed through AI_RELAY_BASE_URL
IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_MODEL_FAST=gpt-image-2.5-flare

# Usage limits, per-identity plan tiers (Free / Supporters / Cools / Owner),
# each with a 5h AND 7d token budget, enforced on chat, titles, and
# memory extraction; failures to read the store fail open
# Ledger is auto off on serverless (Vercel, one shared identity,
# storage resets per cold start); it runs on a VPS or LAN self-host,
# no flag needed
# DEEPCHAT_USAGE_ADMIN enables POST /api/usage for plan changes per
# client IP, default off; never set it on a public deploy, any visitor
# could tier the shared identity
#DEEPCHAT_USAGE_ADMIN=1
